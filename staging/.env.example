# Staging only. Do not point customer-facing pages at this process.
# The server refuses to boot when NODE_ENV=production unless STAGING_ALLOW_PRODUCTION=1.

HOST=127.0.0.1
PORT=8787
NODE_ENV=development

# mock (default, no network, no spend) or openai (OpenAI-compatible chat completions).
CLOSER_LLM_MODE=mock
CLOSER_LLM_API_KEY=
CLOSER_LLM_BASE_URL=https://api.openai.com/v1
CLOSER_LLM_MODEL=gpt-4o-mini

# local (default) extracts text offline. llm uses the same API key only when
# CLOSER_OCR_ALLOW_NETWORK=1 and local extraction found no text.
CLOSER_OCR_MODE=local
CLOSER_OCR_ALLOW_NETWORK=

# Browser origin for the staging UI. * is acceptable only on localhost.
STAGING_CORS_ORIGIN=*

# Must stay unset on any host a customer could reach.
STAGING_ALLOW_PRODUCTION=
